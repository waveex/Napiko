# ── Napiko: zmienne środowiskowe (lokalnie). Skopiuj do .env i uzupełnij sekrety. ──
# Na Netlify ustaw te same zmienne w: Project configuration → Environment variables.

# Baza danych. Lokalnie: kontener z docker-compose.yml.
# Na Netlify z Netlify Database zostaw puste – adres dostarcza platforma.
DATABASE_URL=postgres://oxy:oxy@localhost:5432/oxy
# Neon w UE z osobnymi rolami (ADR-010) – tylko na Netlify / przy konfiguracji bazy:
#  DATABASE_URL           – rola aplikacji (bez własności tabel), np. oxy_app
#  DATABASE_MIGRATION_URL – rola właściciela tabel; migracje uruchamia build (scripts/migrate-on-build.ts)
#  DATABASE_APP_ROLE      – nazwa roli aplikacji; po migracjach dostaje uprawnienia do nowych tabel
# DATABASE_MIGRATION_URL=
# DATABASE_APP_ROLE=oxy_app
# Baza dla testów integracyjnych (czyszczona przy każdym uruchomieniu testów)
TEST_DATABASE_URL=postgres://oxy:oxy@localhost:5432/oxy_test

# Logowanie (Better Auth). Sekret: min. 32 znaki, np. `openssl rand -base64 32`
BETTER_AUTH_SECRET=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki
BETTER_AUTH_URL=http://localhost:3000
# Sekret linków do strony statusu naprawy (min. 32 znaki). Osobny od BETTER_AUTH_SECRET – ustaw przed pilotażem,
# zanim klienci dostaną pierwsze linki (zmiana unieważnia linki przy następnej wiadomości).
# STATUS_LINK_SECRET=
# false: rejestracja loguje od razu i nie wysyła potwierdzenia; true: wymaga potwierdzenia e-mail.
# Po zmianie uruchom serwer ponownie. Włącz po skonfigurowaniu wysyłki poczty.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Dodatkowe zaufane adresy (np. aplikacja mobilna), po przecinku
AUTH_TRUSTED_ORIGINS=

# Poczta: lokalnie Mailpit (podgląd: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Napiko <no-reply@napiko.local>

# Magazyn plików S3: lokalnie MinIO (konsola: http://localhost:9001, login oxy / oxy-secret)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oxy-dev
S3_ACCESS_KEY_ID=oxy
S3_SECRET_ACCESS_KEY=oxy-secret
S3_FORCE_PATH_STYLE=true

# Klucz wywołań wewnętrznych (funkcja cykliczna → kolejka zadań). Min. 24 znaki.
INTERNAL_API_KEY=zmien-mnie-na-losowy-klucz-wewnetrzny

# SMS: "log" (tylko wpis w logach) albo "smsapi" (SMSAPI.pl – wymaga tokenu i zarejestrowanej nazwy nadawcy)
SMS_PROVIDER=log
# SMSAPI_TOKEN=
# Kontrola TLS i autoryzacji bez wysyłki: pnpm sms:check
# Brak nazwy nadawcy w ustawieniach warsztatu oznacza domyślnego nadawcę konta SMSAPI.

# Powiadomienia push (Web Push). Klucze wygeneruje `pnpm push:keys`. Bez kluczy push jest wyłączony
# (zespół ma dzwonek i e-mail, klient dostaje SMS-a). Zmiana kluczy unieważnia włączone powiadomienia.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontakt dla operatorów usług push (mailto: albo https://); domyślnie adres z MAIL_FROM
# VAPID_SUBJECT=mailto:kontakt@twojadomena.pl

# Kotwice dziennika zdarzeń (ADR-010): osobny bucket z włączonym Object Lock (tworzy się go z tą opcją od początku).
# Raz na dobę trafia tam ostatni hash łańcucha każdego warsztatu. Bez ustawienia – brak kotwic.
# AUDIT_ANCHOR_BUCKET=napiko-audit-anchors
# Ile dni kotwica jest nieusuwalna (domyślnie 6 lat)
# AUDIT_ANCHOR_RETENTION_DAYS=2190

# Dane demo (`pnpm db:seed:demo`, tylko lokalnie): e-mail właściciela warsztatu i hasło kont mechanik1..3@demo.oxy.invalid
# DEMO_OWNER_EMAIL=
# DEMO_PASSWORD=
