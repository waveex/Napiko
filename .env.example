# ── OXY: zmienne środowiskowe (lokalnie). Skopiuj do .env i uzupełnij sekrety. ──
# Na Netlify ustaw te same zmienne w: Project configuration → Environment variables.

# Baza danych. Lokalnie: kontener z docker-compose.yml.
# Na Netlify z Netlify Database zostaw puste – adres dostarcza platforma.
DATABASE_URL=postgres://oxy:oxy@localhost:5432/oxy
# Baza dla testów integracyjnych (czyszczona przy każdym uruchomieniu testów)
TEST_DATABASE_URL=postgres://oxy:oxy@localhost:5432/oxy_test

# Logowanie (Better Auth). Sekret: min. 32 znaki, np. `openssl rand -base64 32`
BETTER_AUTH_SECRET=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki
BETTER_AUTH_URL=http://localhost:3000
# false: rejestracja loguje od razu i nie wysyła potwierdzenia; true: wymaga potwierdzenia e-mail.
# Po zmianie uruchom serwer ponownie. Włącz po skonfigurowaniu wysyłki poczty.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Dodatkowe zaufane adresy (np. aplikacja mobilna), po przecinku
AUTH_TRUSTED_ORIGINS=

# Poczta: lokalnie Mailpit (podgląd: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=OXY <no-reply@oxy.local>

# Magazyn plików S3: lokalnie MinIO (konsola: http://localhost:9001, login oxy / oxy-secret)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oxy-dev
S3_ACCESS_KEY_ID=oxy
S3_SECRET_ACCESS_KEY=oxy-secret
S3_FORCE_PATH_STYLE=true

# Klucz wywołań wewnętrznych (funkcja cykliczna → kolejka zadań). Min. 24 znaki.
INTERNAL_API_KEY=zmien-mnie-na-losowy-klucz-wewnetrzny

# SMS: "log" (tylko wpis w logach) albo "smsapi" (SMSAPI.pl – wymaga tokenu i zarejestrowanej nazwy nadawcy)
SMS_PROVIDER=log
# SMSAPI_TOKEN=
