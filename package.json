{
  "name": "oxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OXY – komunikacja i organizacja pracy warsztatów z klientem",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.spec.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:new": "tsx scripts/new-migration.ts",
    "storage:init": "tsx scripts/storage-init.ts",
    "setup": "tsx scripts/migrate.ts && tsx scripts/storage-init.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@netlify/database": "^2.0.1",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/i18n": "^10.6.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "nodemailer": "^10.0.10",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@netlify/functions": "^6.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  }
}
